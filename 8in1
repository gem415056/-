        textarea.id = 'igx-shortcut-textarea';
        textarea.placeholder = "여기에 메시지를 입력하세요...";
        textarea.style.cssText = `
            width: 100%; height: 36px; background: transparent; 
            border: none; outline: none; resize: none; 
            font-family: inherit; font-size: 10pt; line-height: 1.5; 
            padding: 8px 4px; color: inherit; overflow-y: hidden;
            white-space: pre-wrap !important; word-wrap: break-word !important; 
            word-break: break-all !important;
        `;

        const adjustHeight = () => {
            textarea.style.height = 'auto';
            const computed = window.getComputedStyle(textarea);
            const padding = parseInt(computed.paddingTop) + parseInt(computed.paddingBottom);
            const lineHeight = 20; 
            const maxHeight = (lineHeight * 7) + padding;

            if (textarea.scrollHeight > maxHeight) {
                textarea.style.height = maxHeight + 'px';
                textarea.style.overflowY = 'auto';
            } else {
                textarea.style.height = textarea.scrollHeight + 'px';
                textarea.style.overflowY = 'hidden';
            }
            positionModal();
        };

        textarea.addEventListener('input', adjustHeight);

        const stopScroll = (e) => e.stopPropagation();
        textarea.addEventListener('touchstart', stopScroll, { passive: true });
        textarea.addEventListener('touchmove', stopScroll, { passive: true });

        modal.append(headerRow, textarea);
        document.body.appendChild(modal);

        const isEditor = inputEl.tagName !== 'TEXTAREA' && inputEl.isContentEditable;
        textarea.value = isEditor ? inputEl.innerText.replace(/\n$/, '') : inputEl.value;
        
        adjustHeight();
        
        if (window.visualViewport) {
            window.visualViewport.addEventListener('resize', positionModal);
        } else {
            window.addEventListener('resize', positionModal);
        }
        window.addEventListener('scroll', positionModal, true);
    }

    function closeShortcutModal() {
        const modal = document.getElementById('igx-shortcut-modal');
        if (modal) modal.style.display = 'none';
        
        if (window.visualViewport) {
            window.visualViewport.removeEventListener('resize', positionModal);
