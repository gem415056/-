    // ==========================================
    // 모듈 8: 채팅방 자동 스크롤 (순수 원본)
    // ==========================================
    function initAutoScroll() {
        const WAIT_TIME = 500;
        const TOP_THRESHOLD = 2;
        const AT_TOP_STABLE_LIMIT = 3;
        const MAX_STUCK_COUNT = 10;
        const BTN_ID = 'turbo-scroll-btn';
        const STYLE_ID = 'turbo-scroll-style';
        const MESSAGE_SELECTOR = 'div[data-message-group-id]';
        const sleep = ms => new Promise(r => setTimeout(r, ms));

        const iconUp = `<span style="font-size:15px;">△</span>`;
        const iconStop = `<span style="font-size:15px;">▲</span>`;

        let isRunning = false;

        function injectStyle() {
            if (document.getElementById(STYLE_ID)) return;
            const style = document.createElement('style');
            style.id = 'turbo-scroll-style';
            style.textContent = `
                #${BTN_ID}.tm-active { box-shadow: inset 0 0 0 2px hsl(var(--foreground, 0 0% 96%) / 0.65), 0 0 0 1px hsl(var(--foreground, 0 0% 96%) / 0.18); background: hsl(var(--accent, 0 0% 18%)) !important; }
                #${BTN_ID} span { color: inherit !important; fill: currentColor !important; }
            `;
            document.head.appendChild(style);
        }

        function updateIcon(btn, iconHtml) {
            btn.innerHTML = iconHtml;
        }

        function setButtonActive(btn, active) {
            if (!btn) return;
            btn.classList.toggle('tm-active', active);
            if (active) { updateIcon(btn, iconStop); btn.title = '로딩 중지'; btn.style.setProperty('transform', 'scale(0.96)', 'important'); } 
            else { updateIcon(btn, iconUp); btn.title = '과거 채팅 불러오기'; btn.style.setProperty('transform', 'none', 'important'); }
        }

        function isScrollableMessageContainer(el) {
            if (!el || el === document.body || el === document.documentElement) return false;
            const style = window.getComputedStyle(el);
            return (el.scrollHeight > el.clientHeight + 2 && el.clientHeight > 300 && ['auto', 'scroll'].includes(style.overflowY) && el.querySelectorAll(MESSAGE_SELECTOR).length > 0);
        }

        function findScrollContainer() {
            const messages = Array.from(document.querySelectorAll(MESSAGE_SELECTOR));
            if (messages.length > 0) {
                const candidates = new Set();
                const sampleMessages = [messages[0], messages[Math.floor(messages.length / 2)], messages[messages.length - 1]].filter(Boolean);
                for (const msg of sampleMessages) {
                    let current = msg.parentElement;
                    while (current && current !== document.body) { if (isScrollableMessageContainer(current)) candidates.add(current); current = current.parentElement; }
                }
                const sorted = Array.from(candidates).sort((a, b) => {
                    const aMsg = a.querySelectorAll(MESSAGE_SELECTOR).length, bMsg = b.querySelectorAll(MESSAGE_SELECTOR).length;
                    if (aMsg !== bMsg) return bMsg - aMsg;
                    return (b.scrollHeight - b.clientHeight) - (a.scrollHeight - a.clientHeight);
                });
                if (sorted[0]) return sorted[0];
            }
            const fallback = Array.from(document.querySelectorAll('div')).filter(isScrollableMessageContainer).sort((a, b) => {
                const aMsg = a.querySelectorAll(MESSAGE_SELECTOR).length, bMsg = b.querySelectorAll(MESSAGE_SELECTOR).length;
                if (aMsg !== bMsg) return bMsg - aMsg;
                return (b.scrollHeight - b.clientHeight) - (a.scrollHeight - a.clientHeight);
            });
            return fallback[0] || window;
        }

        function scrollToTop(target) {
            if (target === window) { window.scrollTo(0, 0); document.documentElement.scrollTop = 0; document.body.scrollTop = 0; return; }
            target.scrollTop = 0;
            try { target.scrollTo({ top: 0, behavior: 'auto' }); } catch {}
            try { target.dispatchEvent(new WheelEvent('wheel', { bubbles: true, cancelable: true, deltaY: -1500 })); } catch {}
        }

        function getSnapshot(target) {
            const messages = Array.from(document.querySelectorAll(MESSAGE_SELECTOR));
            return { count: messages.length, firstId: messages[0]?.getAttribute('data-message-group-id') || '', lastId: messages[messages.length - 1]?.getAttribute('data-message-group-id') || '', scrollHeight: target === window ? Math.max(document.documentElement.scrollHeight || 0, document.body.scrollHeight || 0) : target.scrollHeight || 0, scrollTop: target === window ? window.scrollY || document.documentElement.scrollTop || document.body.scrollTop || 0 : target.scrollTop || 0 };
        }

        function getContentSignature(snapshot) { return snapshot ? [snapshot.count, snapshot.firstId, snapshot.lastId, snapshot.scrollHeight].join('|') : ''; }

        async function handleClick(e) {
            e.preventDefault(); e.stopPropagation();
            const btn = e.currentTarget;
            if (isRunning) { isRunning = false; setButtonActive(btn, false); return; }
            isRunning = true; setButtonActive(btn, true);
            let prevSignature = '', atTopStableCount = 0, stuckCount = 0;
            while (isRunning) {
                const target = findScrollContainer();
                scrollToTop(target);
                await sleep(WAIT_TIME);
                const snapshot = getSnapshot(target);
                const signature = getContentSignature(snapshot);
                if (snapshot.scrollTop <= TOP_THRESHOLD && signature === prevSignature) atTopStableCount++; else atTopStableCount = 0;
                if (signature === prevSignature) stuckCount++; else stuckCount = 0;
                prevSignature = signature;
                if (atTopStableCount >= AT_TOP_STABLE_LIMIT || stuckCount >= MAX_STUCK_COUNT) break;
            }
            isRunning = false; setButtonActive(btn, false);
        }

        document.addEventListener('keydown', e => { if (e.key === 'Escape') { isRunning = false; const btn = document.getElementById(BTN_ID); if (btn) setButtonActive(btn, false); } });
        injectStyle();

        setInterval(() => {
            const btn = document.getElementById(BTN_ID);
            if (btn && !btn.dataset.hooked) {
                btn.dataset.hooked = 'true';
                updateIcon(btn, iconUp);
                btn.onclick = handleClick;
                setButtonActive(btn, isRunning);
            }
        }, 1000);
    }

    // ==========================================
    // 대사/기호 팝업 내 텍스트 주입 헬퍼
    // ==========================================
    function insertSymbolToModal(openSymbol, closeSymbol) {
        const textarea = document.getElementById('igx-shortcut-textarea');
        if (!textarea) return;

        const start = textarea.selectionStart;
        const end = textarea.selectionEnd;
        const text = textarea.value;

        const before = text.substring(0, start);
        const selected = text.substring(start, end);
        const after = text.substring(end);

        const newText = before + openSymbol + selected + closeSymbol + after;
        textarea.value = newText;

        const newCursorPos = start + openSymbol.length + selected.length;
        textarea.focus();
        textarea.setSelectionRange(newCursorPos, newCursorPos);

        textarea.dispatchEvent(new Event('input', { bubbles: true }));
    }

    // ==========================================
    // 원래 TIPTAP으로 무결성 데이터 쓰기 (대체식)
    // ==========================================
    function writeToTiptap(text) {
        const tiptap = getSafeMainInput();
        if (!tiptap) return;

        window.allowNativeFocus = true;
        window.isSyncingText = true;

        tiptap.focus();

        try {
            const range = document.createRange();
            range.selectNodeContents(tiptap);
            const sel = window.getSelection();
            sel.removeAllRanges();
            sel.addRange(range);
        } catch (e) {
            window.getSelection().selectAllChildren(tiptap);
        }

        document.execCommand('delete', false, null); // 비우기
        document.execCommand('insertText', false, text); // 주입

        setTimeout(() => {
            window.allowNativeFocus = false;
            window.isSyncingText = false;
            tiptap.blur();
        }, 100);
    }

    // ==========================================
    // 모듈 9: 에디터 대치식 밀착형 정밀 팝업 (가림막 및 툴바 완전 최적화 버전)
    // ==========================================
    function createShortcutModal() {
        const inputEl = getSafeMainInput();
        if (!inputEl) return;

        const container = inputEl.closest(".flex.w-full.flex-col.rounded-lg") || inputEl.closest(".flex.w-full.flex-col") || inputEl.parentElement;
        if (!container) return;

        let modal = document.getElementById('igx-shortcut-modal');
        if (modal) return;

        // 원본과 너비를 완전히 같게 일치시키기 위한 오프셋 덮개 스타일링
        const computed = window.getComputedStyle(container);
        const bg = computed.backgroundColor || '#242424';
        const border = computed.borderColor || '#444';
        const borderRadius = computed.borderRadius || '12px';

        modal = document.createElement('div');
        modal.id = 'igx-shortcut-modal';
        
        // 피드백 반영: 오리지널 외곽 보더라인을 완전히 숨기도록 좌우/아래 -1.5px 아웃라인 오프셋 지정
        // 피드백 반영: z-index는 대화 레이어 위에 배치되되 상위 시스템창 아래에 있도록 '50'으로 특별 가중치 적용
        modal.style.cssText = `
            display: none; position: absolute; bottom: -1.5px; left: -1.5px; right: -1.5px; 
            background: ${bg}; border: 1px solid ${border}; border-radius: ${borderRadius}; 
            padding: 12px; z-index: 50 !important; box-shadow: 0 4px 20px rgba(0,0,0,0.35);
            font-family: 'Pretendard', sans-serif; box-sizing: border-box;
        `;

        // 상단 도구 모음 행 (좌측 대사 도우미 / 우측 취소 및 입력 배치)
        const headerRow = document.createElement('div');
        headerRow.style.cssText = "display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; border-bottom: 1px solid rgba(128,128,128,0.15); padding-bottom: 8px;";

        // 좌상단 단축기호 배치 (오리지널 size-7 (28px) 크기로 완벽하게 복구)
        const leftToolbar = document.createElement('div');
        leftToolbar.style.cssText = "display: flex; gap: 4px; align-items: center;";

        const symbols = [
            { icon: '★', open: '*', close: '*' },
            { icon: '♠', open: '"', close: '"' },
            { icon: '♤', open: "'", close: "'" },
            { icon: '◆', open: '`', close: '`' },
            { icon: '■', open: '[', close: ']' },
            { icon: '♣', open: '(OOC：', close: ')' }
        ];

        symbols.forEach(s => {
            const btn = document.createElement('button');
            // 피드백 반영: 대사도우미 원래 최적의 누름 크기(28px)로 복구 완료
            btn.className = "relative inline-flex items-center justify-center rounded-full text-xs font-medium transition-colors border border-border bg-card text-line-gray-1 hover:bg-secondary p-0 size-7";
            btn.type = "button";
            btn.style.width = '28px';
            btn.style.height = '28px';
            btn.style.cursor = 'pointer';
            btn.innerHTML = `<span style="font-size:14px; font-weight:normal;">${s.icon}</span>`;
            btn.onmousedown = (e) => e.preventDefault();
            btn.onclick = (e) => {
                e.preventDefault();
                insertSymbolToModal(s.open, s.close);
            };
            leftToolbar.appendChild(btn);
        });

        // 우상단 취소/입력 배치 (취소와 입력을 가로 세로 규격이 일치하는 동일 콤팩트한 크기로 대칭 조화)
        const rightToolbar = document.createElement('div');
        rightToolbar.style.cssText = "display: flex; gap: 6px; align-items: center;";

        const cancelBtn = document.createElement('button');
        cancelBtn.textContent = "취소";
        // 피드백 반영: 버튼 크기를 가로 52px, 세로 24px로 슬림하게 통일화
        cancelBtn.style.cssText = `
            display: inline-flex; align-items: center; justify-content: center;
            border-radius: 6px; font-size: 11px; font-weight: 500;
            border: 1px solid rgba(128,128,128,0.2); background: transparent;
            color: inherit; cursor: pointer; width: 52px; height: 24px; box-sizing: border-box;
        `;
        cancelBtn.onclick = closeShortcutModal;

        const sendBtn = document.createElement('button');
        // 피드백 반영: '전송' -> '입력'으로 변경
        sendBtn.textContent = "입력";
        // 피드백 반영: 버튼 크기를 취소 버튼과 동일하게 52px * 24px로 통일화
        sendBtn.style.cssText = `
            display: inline-flex; align-items: center; justify-content: center;
            border-radius: 6px; font-size: 11px; font-weight: 600;
            border: none; background-color: rgb(249, 182, 0);
            color: #ffffff; cursor: pointer; width: 52px; height: 24px; box-sizing: border-box;
        `;
        sendBtn.onclick = () => {
            const textarea = document.getElementById('igx-shortcut-textarea');
            if (textarea) {
                writeToTiptap(textarea.value);
            }
            closeShortcutModal();
        };

        rightToolbar.append(cancelBtn, sendBtn);
        headerRow.append(leftToolbar, rightToolbar);

        // 입력 텍스트 상자 (10pt 폰트, 자동 줄바꿈, 위로 늘어나는 가변 크기 최대 7줄)
        const textarea = document.createElement('textarea');
        textarea.id = 'igx-shortcut-textarea';
        textarea.placeholder = "여기에 메시지를 입력하세요...";
        textarea.style.cssText = `
            width: 100%; height: 36px; background: transparent; 
            border: none; outline: none; resize: none; 
            font-family: inherit; font-size: 10pt; line-height: 1.5; 
            padding: 8px 4px; color: inherit; overflow-y: hidden;
            white-space: pre-wrap !important; word-wrap: break-word !important; 
            word-break: break-all !important;
        `;

        // 위로 크기가 늘어나는 가변 확장 로직
        const adjustHeight = () => {
            textarea.style.height = 'auto';
            const computed = window.getComputedStyle(textarea);
            const padding = parseInt(computed.paddingTop) + parseInt(computed.paddingBottom);
            const lineHeight = 20; // 10pt 기준 line-height 1.5배율
            const maxHeight = (lineHeight * 7) + padding;

            if (textarea.scrollHeight > maxHeight) {
                textarea.style.height = maxHeight + 'px';
                textarea.style.overflowY = 'auto';
            } else {
                textarea.style.height = textarea.scrollHeight + 'px';
                textarea.style.overflowY = 'hidden';
            }
        };

        textarea.addEventListener('input', adjustHeight);

        // 스크롤 간섭 배제
        const stopScroll = (e) => e.stopPropagation();
        textarea.addEventListener('touchstart', stopScroll, { passive: true });
        textarea.addEventListener('touchmove', stopScroll, { passive: true });

        modal.append(headerRow, textarea);
        
        // 가변 위로 팽창할 때 TIPTAP 부모 프레임에서 가려져 안 보이지 않도록 오버플로우 한계 제거
        container.style.position = 'relative';
        container.style.overflow = 'visible'; // 팝업 확장 시 잘림 가드 개방
        container.appendChild(modal);

        // 입력 값 팝업창으로 최초 연동
        const isEditor = inputEl.tagName !== 'TEXTAREA' && inputEl.isContentEditable;
        textarea.value = isEditor ? inputEl.innerText.replace(/\n$/, '') : inputEl.value;
        adjustHeight();
    }

    function closeShortcutModal() {
        const modal = document.getElementById('igx-shortcut-modal');
        if (modal) modal.style.display = 'none';
    }

    window.openShortcutModal = function () {
        const inputEl = getSafeMainInput();
        if (!inputEl) return;

        createShortcutModal();
        const modal = document.getElementById('igx-shortcut-modal');
        const textarea = document.getElementById('igx-shortcut-textarea');
        if (!modal || !textarea) return;

        // 양방향 데이터 연동: TIPTAP에 적혀 있던 내용을 무결성하게 다시 가져옴
        const isEditor = inputEl.tagName !== 'TEXTAREA' && inputEl.isContentEditable;
        const currentText = isEditor ? inputEl.innerText.replace(/\n$/, '') : inputEl.value;

        modal.style.display = 'block';
        textarea.value = currentText;

        // 가변 높이 재계산
        textarea.style.height = 'auto';
        textarea.style.height = textarea.scrollHeight + 'px';

        setTimeout(() => {
            textarea.focus();
            textarea.setSelectionRange(textarea.value.length, textarea.value.length);
        }, 50);
    };

    // ==========================================
    // 통합팩 동시 실행 관리 및 레이아웃 밀림 해결사
    // ==========================================
    function startAll() {
        setInterval(() => {
            const inputEl = getSafeMainInput();
            if (inputEl) {
                const scrollParent = inputEl.closest('.overflow-y-scroll');
                if (scrollParent && scrollParent.style.overflowY !== 'hidden') {
                    scrollParent.style.overflowY = 'hidden';
                }
            }
        }, 1000);

        try {
            setTimeout(() => {
                try { initTurnCracker(); } catch (e) { console.error("[ 9in1 통합팩 ] 크래커 모듈 오류:", e); }
            }, 100);

            try { initDoubleClick(); } catch (e) { console.error("[ 9in1 통합팩 ] 더블클릭 모듈 오류:", e); }
            try { initRerollHold();  } catch (e) { console.error("[ 9in1 통합팩 ] 리롤 홀드 모듈 오류:", e); }
            try { initSendHold();    } catch (e) { console.error("[ 9in1 통합팩 ] 전송 홀드 모듈 오류:", e); }
            try { initRPToolbar();   } catch (e) { console.error("[ 9in1 통합팩 ] 대사 툴바 모듈 오류:", e); }
            try { initAutoSaver();   } catch (e) { console.error("[ 9in1 통합팩 ] 임시저장 모듈 오류:", e); }
            try { initRadiosonde();  } catch (e) { console.error("[ 9in1 통합팩 ] 라디오존데 모듈 오류:", e); }
            try { initAutoScroll();  } catch (e) { console.error("[ 9in1 통합팩 ] 오토스크롤 모듈 오류:", e); }
        } catch(e) {
            console.error("[ 9in1 통합팩 ] 치명적인 시작 오류 발생:", e);
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', startAll);
    } else {
        startAll();
    }

})();
