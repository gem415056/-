(function () {
    'use strict';

    // 글로벌 네이티브 입력 허용 플래그
    window.allowNativeFocus = false;
    window.isSyncingText = false;

    // [도움함수] 여러 입력창 중 '진짜 메인 입력창'만 골라내는 기능
    function getSafeMainInput() {
        const inputs = document.querySelectorAll('textarea[placeholder*="메시지"], div.__chat_input_textarea, .tiptap.ProseMirror');
        for (const el of inputs) {
            if (el.closest('div[data-message-group-id]')) continue;
            if (el.closest(".flex.w-full.flex-col")) return el;
        }
        return null;
    }

    // ==========================================
    // 모듈 1: 전송 홀드
    // ==========================================
    function initSendHold() {
        const HOLD_MS = 600;
        let isConfirmed = false;
        let holdTimer = null;

        const css = `
            #sh-progress-ring { position: fixed; pointer-events: none; z-index: 999999; display: none; }
            #sh-progress-ring.active { display: block; }
            #sh-progress-ring circle.track { fill: none; stroke: rgba(255,255,255,.15); stroke-width: 3; }
            #sh-progress-ring circle.fill { fill: none; stroke: #f97316; stroke-width: 3; stroke-linecap: round; transform: rotate(-90deg); transform-origin: center; transform-box: fill-box; transition: stroke-dashoffset linear; }
        `;
        const styleEl = document.createElement('style');
        styleEl.textContent = css;
        document.head.appendChild(styleEl);

        const ring = document.createElement('div');
        ring.id = 'sh-progress-ring';
        ring.innerHTML = `<svg id="sh-svg"><circle class="track"/><circle class="fill"/></svg>`;
        document.body.appendChild(ring);

        const svg = ring.querySelector('svg');
        const trackCircle = ring.querySelector('circle.track');
        const fillCircle  = ring.querySelector('circle.fill');

        function isStopButton(btn) {
            const path = btn.querySelector('svg path');
            const d = path?.getAttribute('d') || '';
            return d.includes('M6 6h12v12H6Z');
        }

        function isGeneralSendButton(btn) {
            if (!btn) return false;
            const cls = btn.className || '';
            return (
                cls.includes('bg-primary') &&
                cls.includes('rounded-full') &&
                cls.includes('text-primary-foreground')
            );
        }

        function isHoldableSendBtn(el) {
            return isGeneralSendButton(el) && !isStopButton(el);
        }

        function showRing(btn) {
            const rect = btn.getBoundingClientRect();
            const size = Math.max(rect.width, rect.height) + 4;
            const cx = size / 2, cy = size / 2, r = (size / 2) - 2;
            const circumference = 2 * Math.PI * r;

            svg.setAttribute('width', size); svg.setAttribute('height', size);
            svg.setAttribute('viewBox', `0 0 ${size} ${size}`);
            trackCircle.setAttribute('cx', cx); trackCircle.setAttribute('cy', cy); trackCircle.setAttribute('r', r);
            fillCircle.setAttribute('cx', cx); fillCircle.setAttribute('cy', cy); fillCircle.setAttribute('r', r);
            fillCircle.style.strokeDasharray  = circumference;
            fillCircle.style.strokeDashoffset = circumference;

            ring.style.left = `${rect.left - 2}px`; ring.style.top  = `${rect.top - 2}px`;
            ring.classList.add('active');

            requestAnimationFrame(() => {
                fillCircle.style.transition = `stroke-dashoffset ${HOLD_MS}ms linear`;
                fillCircle.style.strokeDashoffset = '0';
            });
        }

        function hideRing() {
            ring.classList.remove('active');
            fillCircle.style.transition = 'none';
            if (fillCircle.style.strokeDasharray) fillCircle.style.strokeDashoffset = fillCircle.style.strokeDasharray;
        }

        function cancel() {
            if (!holdTimer) return;
            clearTimeout(holdTimer);
            holdTimer = null;
            hideRing();
        }

        document.addEventListener('click', (e) => {
            const btn = e.target.closest('button');
            if (!isHoldableSendBtn(btn)) return;
            if (isConfirmed) { isConfirmed = false; return; }
            e.preventDefault(); e.stopPropagation(); e.stopImmediatePropagation();
        }, true);

        function handlePressStart(e) {
            const btn = e.target.closest('button');
            if (!isHoldableSendBtn(btn)) return;
            if (e.type === 'touchstart') e.preventDefault();
            showRing(btn);
            holdTimer = setTimeout(() => { hideRing(); isConfirmed = true; btn.click(); holdTimer = null; }, HOLD_MS);
        }

        document.addEventListener('mousedown', handlePressStart);
        document.addEventListener('mouseup', cancel);
        document.addEventListener('mouseleave', cancel);
        document.addEventListener('touchstart', handlePressStart, { passive: false });
        document.addEventListener('touchend', cancel);
        document.addEventListener('touchcancel', cancel);
    }

    // ==========================================
    // 모듈 2: 리롤 홀드
    // ==========================================
    function initRerollHold() {
        const HOLD_MS = 600;
        let isConfirmed = false;
        let holdTimer = null;

        const css = `
            #rr-progress-ring { position: fixed; pointer-events: none; z-index: 999999; display: none; }
            #rr-progress-ring.active { display: block; }
            #rr-progress-ring circle.track { fill: none; stroke: rgba(255,255,255,.15); stroke-width: 3; }
            #rr-progress-ring circle.fill { fill: none; stroke: #e8302a; stroke-width: 3; stroke-linecap: round; transform: rotate(-90deg); transform-origin: center; transform-box: fill-box; transition: stroke-dashoffset linear; }
        `;
        const styleEl = document.createElement('style');
        styleEl.textContent = css;
        document.head.appendChild(styleEl);

        const ring = document.createElement('div');
        ring.id = 'rr-progress-ring';
        ring.innerHTML = `<svg id="rr-svg"><circle class="track"/><circle class="fill"/></svg>`;
        document.body.appendChild(ring);

        const svg = ring.querySelector('svg');
        const trackCircle = ring.querySelector('circle.track');
        const fillCircle  = ring.querySelector('circle.fill');

        function isRerollBtn(el) {
            if (!el) return false;
            if (el.id === 'exp-reroll-btn') return true;
            return el.querySelector?.('svg path')?.getAttribute('d')?.startsWith('M3.8 12a8.2') ?? false;
        }

        function showRing(btn) {
            const rect = btn.getBoundingClientRect();
            const size = Math.max(rect.width, rect.height);
            const cx = size / 2, cy = size / 2, r = (size / 2) - 2;
            const circumference = 2 * Math.PI * r;

            svg.setAttribute('width', size); svg.setAttribute('height', size);
            svg.setAttribute('viewBox', `0 0 ${size} ${size}`);
            trackCircle.setAttribute('cx', cx); trackCircle.setAttribute('cy', cy); trackCircle.setAttribute('r', r);
            fillCircle.setAttribute('cx', cx); fillCircle.setAttribute('cy', cy); fillCircle.setAttribute('r', r);
            fillCircle.style.strokeDasharray  = circumference;
            fillCircle.style.strokeDashoffset = circumference;

            ring.style.left = `${rect.left}px`; ring.style.top  = `${rect.top}px`;
            ring.classList.add('active');

            requestAnimationFrame(() => {
                fillCircle.style.transition = `stroke-dashoffset ${HOLD_MS}ms linear`;
                fillCircle.style.strokeDashoffset = '0';
            });
        }

        function hideRing() {
            ring.classList.remove('active');
            fillCircle.style.transition = 'none';
            if (fillCircle.style.strokeDasharray) fillCircle.style.strokeDashoffset = fillCircle.style.strokeDasharray;
        }

        function cancel() {
            if (!holdTimer) return;
            clearTimeout(holdTimer);
            holdTimer = null;
            hideRing();
        }

        document.addEventListener('click', (e) => {
            const btn = e.target.closest('button, [id="exp-reroll-btn"]');
            if (!isRerollBtn(btn)) return;
            if (isConfirmed) { isConfirmed = false; return; }
            e.preventDefault(); e.stopPropagation(); e.stopImmediatePropagation();
        }, true);

        document.addEventListener('mousedown', (e) => {
            const btn = e.target.closest('button, [id="exp-reroll-btn"]');
            if (!isRerollBtn(btn)) return;
            showRing(btn);
            holdTimer = setTimeout(() => { hideRing(); isConfirmed = true; btn.click(); holdTimer = null; }, HOLD_MS);
        });

        document.addEventListener('mouseup', cancel);
        document.addEventListener('mouseleave', cancel);
        document.addEventListener('touchstart', (e) => {
            const btn = e.target.closest('button, [id="exp-reroll-btn"]');
            if (!isRerollBtn(btn)) return;
            e.preventDefault(); showRing(btn);
            holdTimer = setTimeout(() => { hideRing(); isConfirmed = true; btn.click(); holdTimer = null; }, HOLD_MS);
        }, { passive: false });
        document.addEventListener('touchend', cancel);
        document.addEventListener('touchcancel', cancel);
    }

    // ==========================================
    // 모듈 3: 더블클릭 수정
    // ==========================================
    function initDoubleClick() {
        function findMessageContainer(target) {
            let el = target;
            while (el && el !== document.body) {
                if (el.hasAttribute('data-message-group-id')) return el;
                el = el.parentElement;
            }
            return null;
        }

        function getReactProps(el) {
            const key = Object.keys(el).find(k => k.startsWith('__reactProps'));
            return key ? el[key] : null;
        }

        function firePointerClick(el) {
            const opts = { bubbles: true, cancelable: true };
            el.dispatchEvent(new PointerEvent('pointerover', opts));
            el.dispatchEvent(new PointerEvent('pointerenter', opts));
            el.dispatchEvent(new MouseEvent('mouseenter', opts));
            el.dispatchEvent(new PointerEvent('pointerdown', opts));
            el.dispatchEvent(new PointerEvent('pointerup', opts));
            el.click();
        }

        function tryReactEditClick(container) {
            const trigger = container.querySelector('div[aria-haspopup="menu"]');
            if (!trigger) return false;

            const style = document.createElement('style');
            style.id = 'igx-hide-dropdown';
            style.textContent = `[data-radix-popper-content-wrapper], [role="menu"] { opacity: 0 !important; pointer-events: none !important; }`;
            document.head.appendChild(style);

            firePointerClick(trigger);

            const start = Date.now();
            const timer = setInterval(() => {
                const item = Array.from(document.querySelectorAll('div[role="menuitem"]')).find(el => el.textContent.includes('수정'));
                if (item) {
                    clearInterval(timer);
                    const props = getReactProps(item);
                    if (props?.onSelect) props.onSelect();
                    else firePointerClick(item);
                    setTimeout(() => style.remove(), 100);
                } else if (Date.now() - start > 1500) {
                    clearInterval(timer);
                    style.remove();
                }
            }, 30);
            return true;
        }

        document.addEventListener('dblclick', (e) => {
            const container = findMessageContainer(e.target);
            if (!container) return;
            window.getSelection().removeAllRanges();
            tryReactEditClick(container);
        });
    }

    // ==========================================
    // 모듈 4: 오토스크롤
    // ==========================================
    function initAutoScroll() {
        const WAIT_TIME = 500;
        const TOP_THRESHOLD = 2;
        const AT_TOP_STABLE_LIMIT = 3;
        const MAX_STUCK_COUNT = 10;
        const BTN_ID = 'turbo-scroll-btn';
        const STYLE_ID = 'turbo-scroll-style';
        const MESSAGE_SELECTOR = 'div[data-message-group-id]';
        const sleep = ms => new Promise(r => setTimeout(r, ms));

        const iconUp = `<span style="font-size:15px;">△</span>`;
        const iconStop = `<span style="font-size:15px;">▲</span>`;

        let isRunning = false;

        function injectStyle() {
            if (document.getElementById(STYLE_ID)) return;
            const style = document.createElement('style');
            style.id = 'turbo-scroll-style';
            style.textContent = `
                #${BTN_ID}.tm-active { box-shadow: inset 0 0 0 2px hsl(var(--foreground, 0 0% 96%) / 0.65), 0 0 0 1px hsl(var(--foreground, 0 0% 96%) / 0.18); background: hsl(var(--accent, 0 0% 18%)) !important; }
                #${BTN_ID} span { color: inherit !important; fill: currentColor !important; }
            `;
            document.head.appendChild(style);
        }

        function updateIcon(btn, iconHtml) {
            btn.innerHTML = iconHtml;
        }

        function setButtonActive(btn, active) {
            if (!btn) return;
            btn.classList.toggle('tm-active', active);
            if (active) { updateIcon(btn, iconStop); btn.title = '로딩 중지'; btn.style.setProperty('transform', 'scale(0.96)', 'important'); } 
            else { updateIcon(btn, iconUp); btn.title = '과거 채팅 불러오기'; btn.style.setProperty('transform', 'none', 'important'); }
        }

        function isScrollableMessageContainer(el) {
            if (!el || el === document.body || el === document.documentElement) return false;
            const style = window.getComputedStyle(el);
            return (el.scrollHeight > el.clientHeight + 2 && el.clientHeight > 300 && ['auto', 'scroll'].includes(style.overflowY) && el.querySelectorAll(MESSAGE_SELECTOR).length > 0);
        }

        function findScrollContainer() {
            const messages = Array.from(document.querySelectorAll(MESSAGE_SELECTOR));
            if (messages.length > 0) {
                const candidates = new Set();
                const sampleMessages = [messages[0], messages[Math.floor(messages.length / 2)], messages[messages.length - 1]].filter(Boolean);
                for (const msg of sampleMessages) {
                    let current = msg.parentElement;
                    while (current && current !== document.body) { if (isScrollableMessageContainer(current)) candidates.add(current); current = current.parentElement; }
                }
                const sorted = Array.from(candidates).sort((a, b) => {
                    const aMsg = a.querySelectorAll(MESSAGE_SELECTOR).length, bMsg = b.querySelectorAll(MESSAGE_SELECTOR).length;
                    if (aMsg !== bMsg) return bMsg - aMsg;
                    return (b.scrollHeight - b.clientHeight) - (a.scrollHeight - a.clientHeight);
                });
                if (sorted[0]) return sorted[0];
            }
            const fallback = Array.from(document.querySelectorAll('div')).filter(isScrollableMessageContainer).sort((a, b) => {
                const aMsg = a.querySelectorAll(MESSAGE_SELECTOR).length, bMsg = b.querySelectorAll(MESSAGE_SELECTOR).length;
                if (aMsg !== bMsg) return bMsg - aMsg;
                return (b.scrollHeight - b.clientHeight) - (a.scrollHeight - a.clientHeight);
            });
            return fallback[0] || window;
        }

        function scrollToTop(target) {
            if (target === window) { window.scrollTo(0, 0); document.documentElement.scrollTop = 0; document.body.scrollTop = 0; return; }
            target.scrollTop = 0;
            try { target.scrollTo({ top: 0, behavior: 'auto' }); } catch {}
            try { target.dispatchEvent(new WheelEvent('wheel', { bubbles: true, cancelable: true, deltaY: -1500 })); } catch {}
        }

        function getSnapshot(target) {
            const messages = Array.from(document.querySelectorAll(MESSAGE_SELECTOR));
            return { count: messages.length, firstId: messages[0]?.getAttribute('data-message-group-id') || '', lastId: messages[messages.length - 1]?.getAttribute('data-message-group-id') || '', scrollHeight: target === window ? Math.max(document.documentElement.scrollHeight || 0, document.body.scrollHeight || 0) : target.scrollHeight || 0, scrollTop: target === window ? window.scrollY || document.documentElement.scrollTop || document.body.scrollTop || 0 : target.scrollTop || 0 };
        }

        function getContentSignature(snapshot) { return snapshot ? [snapshot.count, snapshot.firstId, snapshot.lastId, snapshot.scrollHeight].join('|') : ''; }

        async function handleClick(e) {
            e.preventDefault(); e.stopPropagation();
            const btn = e.currentTarget;
            if (isRunning) { isRunning = false; setButtonActive(btn, false); return; }
            isRunning = true; setButtonActive(btn, true);
            let prevSignature = '', atTopStableCount = 0, stuckCount = 0;
            while (isRunning) {
                const target = findScrollContainer();
                scrollToTop(target);
                await sleep(WAIT_TIME);
                const snapshot = getSnapshot(target);
                const signature = getContentSignature(snapshot);
                if (snapshot.scrollTop <= TOP_THRESHOLD && signature === prevSignature) atTopStableCount++; else atTopStableCount = 0;
                if (signature === prevSignature) stuckCount++; else stuckCount = 0;
                prevSignature = signature;
                if (atTopStableCount >= AT_TOP_STABLE_LIMIT || stuckCount >= MAX_STUCK_COUNT) break;
            }
            isRunning = false; setButtonActive(btn, false);
        }

        document.addEventListener('keydown', e => { if (e.key === 'Escape') { isRunning = false; const btn = document.getElementById(BTN_ID); if (btn) setButtonActive(btn, false); } });
        injectStyle();

        setInterval(() => {
            const btn = document.getElementById(BTN_ID);
            if (btn && !btn.dataset.hooked) {
                btn.dataset.hooked = 'true';
                updateIcon(btn, iconUp);
                btn.onclick = handleClick;
                setButtonActive(btn, isRunning);
            }
        }, 1000);
    }

    // ==========================================
    // 모듈 5: 메시지 시간 표기
    // ==========================================
    function initMessageTimeBadge() {
        const API_BASE = 'https://crack-api.wrtn.ai/crack-gen/v3';
        const SCRIPT_NS = 'crack-message-time-badge';
        const BADGE_CLASS = `${SCRIPT_NS}-badge`;
        const MESSAGE_SELECTOR = 'div[data-message-group-id]';
        const MESSAGE_LIMIT = 200;

        const RESOLVE_COMPARE_BY_API = true;

        let lastUrlKey = getUrlKey();
        let scanTimer = null;
        let apiCache = null;
        let apiPromise = null;
        const resultCache = new Map();

        function getUrlKey() {
            return location.origin + location.pathname + location.search;
        }

        function resetPageCacheIfNeeded() {
            const key = getUrlKey();
            if (key === lastUrlKey) return;

            lastUrlKey = key;
            apiCache = null;
            apiPromise = null;
            resultCache.clear();
        }

        function normalizeText(text = '') {
            return String(text || '').replace(/\s+/g, ' ').trim();
        }

        function getCookie(name) {
            const escaped = name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            const match = document.cookie.match(new RegExp('(?:^|; )' + escaped + '=([^;]*)'));
            return match ? decodeURIComponent(match[1]) : null;
        }

        function getAccessToken() {
            return getCookie('access_token');
        }

        function getCommonHeaders() {
            const token = getAccessToken();
            const headers = {
                accept: 'application/json, text/plain, */*',
                platform: 'web',
                'wrtn-locale': 'ko-KR'
            };

            if (token) headers.authorization = `Bearer ${token}`;

            const wrtnId = getCookie('__w_id');
            if (wrtnId) headers['x-wrtn-id'] = wrtnId;

            const mixpanelId = getCookie('Mixpanel-Distinct-Id');
            if (mixpanelId) headers['mixpanel-distinct-id'] = mixpanelId;

            return headers;
        }

        function extractChatIdFromUrl(url = location.href) {
            const str = String(url || '');
            const patterns = [
                /\/episodes\/([a-f0-9]{24})(?:[/?#]|$)/i,
                /\/chats\/([a-f0-9]{24})(?:[/?#]|$)/i,
                /"chatId":"([a-f0-9]{24})"/i
            ];

            for (const pattern of patterns) {
                const match = str.match(pattern);
                if (match) return match[1];
            }

            return null;
        }

        function findChatId() {
            const fromUrl = extractChatIdFromUrl();
            if (fromUrl) return fromUrl;

            try {
                return extractChatIdFromUrl(document.documentElement.innerHTML);
            } catch (e) {
                return null;
            }
        }

        async function fetchAllMessagesOnce() {
            if (apiCache) return apiCache;
            if (apiPromise) return apiPromise;

            const chatId = findChatId();
            if (!chatId) throw new Error('chatId not found');

            apiPromise = fetch(`${API_BASE}/chats/${chatId}/messages?limit=${MESSAGE_LIMIT}`, {
                method: 'GET',
                credentials: 'include',
                headers: getCommonHeaders()
            })
                .then(async res => {
                    if (!res.ok) throw new Error(`messages fetch failed: ${res.status}`);
                    const json = await res.json();
                    const messages = json?.data?.messages || json?.messages || [];
                    const list = Array.isArray(messages) ? messages : [];
                    apiCache = buildApiCache(list);
                    return apiCache;
                })
                .catch(err => {
                    console.warn('[Crack Message Time Badge] API resolve failed:', err);
                    apiCache = null;
                    throw err;
                })
                .finally(() => {
                    apiPromise = null;
                });

            return apiPromise;
        }

        function buildApiCache(messages) {
            const idMap = new Map();
            const apiIndexMap = new Map();

            messages.forEach((msg, index) => {
                const id = messageIdOf(msg);
                if (!id) return;
                idMap.set(id, msg);
                apiIndexMap.set(id, index);
            });

            return { messages, idMap, apiIndexMap };
        }

        function messageIdOf(msg) {
            return msg?._id || msg?.id || '';
        }

        function isAssistantMessage(msg) {
            return String(msg?.role || '').toLowerCase() === 'assistant';
        }

        function sortVariantsUiOrder(variants, apiIndexMap) {
            return [...variants].sort((a, b) => {
                const ai = apiIndexMap.get(messageIdOf(a)) ?? 0;
                const bi = apiIndexMap.get(messageIdOf(b)) ?? 0;
                return bi - ai;
            });
        }

        function getGroupMessageId(group) {
            return group?.getAttribute?.('data-message-group-id') || '';
        }

        function isObjectId(value = '') {
            return /^[a-f0-9]{24}$/i.test(String(value || ''));
        }

        function objectIdToDate(objectId = '') {
            if (!isObjectId(objectId)) return null;

            const seconds = parseInt(String(objectId).slice(0, 8), 16);
            if (!Number.isFinite(seconds) || seconds <= 0) return null;

            const date = new Date(seconds * 1000);
            if (Number.isNaN(date.getTime())) return null;

            return date;
        }

        function findCompareButtonInGroup(group) {
            if (!group) return null;

            const buttons = Array.from(group.querySelectorAll('button'));
            return buttons.find(btn => /답변\s*비교\s*\d+\s*\/\s*\d+/.test(normalizeText(btn.textContent || ''))) || null;
        }

        function parseCompareButton(group) {
            const btn = findCompareButtonInGroup(group);
            if (!btn) return null;

            const text = normalizeText(btn.textContent || '');
            const match = text.match(/답변\s*비교\s*(\d+)\s*\/\s*(\d+)/);
            if (!match) return null;

            return {
                text,
                current: Number(match[1]),
                total: Number(match[2])
            };
        }

        function makeCacheKey(group) {
            const id = getGroupMessageId(group);
            const compare = parseCompareButton(group);
            return compare ? `${id}:${compare.current}/${compare.total}` : id;
        }

        function resolveByDomId(group) {
            const domId = getGroupMessageId(group);
            const date = objectIdToDate(domId);

            return {
                messageId: domId,
                date,
                source: 'dom',
                note: date ? 'DOM messageId 기준 생성 시각' : 'ObjectId 형식이 아니어서 시간 계산 불가'
            };
        }

        async function resolveCurrentMessageTime(group) {
            const fallback = resolveByDomId(group);
            const compare = parseCompareButton(group);

            if (!RESOLVE_COMPARE_BY_API || !compare || compare.total <= 1) return fallback;
            if (!fallback.messageId || !isObjectId(fallback.messageId)) return fallback;

            try {
                const { messages, idMap, apiIndexMap } = await fetchAllMessagesOnce();
                const anchor = idMap.get(fallback.messageId);

                if (!anchor || !isAssistantMessage(anchor) || !anchor.parentTurnId) return fallback;

                const variants = messages.filter(msg =>
                    isAssistantMessage(msg) &&
                    msg.parentTurnId &&
                    msg.parentTurnId === anchor.parentTurnId &&
                    messageIdOf(msg)
                );

                if (variants.length !== compare.total) return fallback;

                const ordered = sortVariantsUiOrder(variants, apiIndexMap);
                const currentMsg = ordered[compare.current - 1];
                const currentId = messageIdOf(currentMsg);
                const date = objectIdToDate(currentId);

                if (!date) return fallback;

                return {
                    messageId: currentId,
                    date,
                    source: 'api-current-reroll',
                    note: `답변 비교 ${compare.current}/${compare.total} 현재 답변 기준 생성 시각`
                };
            } catch (e) {
                return fallback;
            }
        }

        function pad2(n) {
            return String(n).padStart(2, '0');
        }

        function formatBadgeDate(date) {
            if (!date) return '';
            return `${date.getFullYear()}.${pad2(date.getMonth() + 1)}.${pad2(date.getDate())}. ${pad2(date.getHours())}:${pad2(date.getMinutes())}`;
        }

        function formatFullDate(date) {
            if (!date) return '';

            return `${date.getFullYear()}-${pad2(date.getMonth() + 1)}-${pad2(date.getDate())} ` +
                `${pad2(date.getHours())}:${pad2(date.getMinutes())}:${pad2(date.getSeconds())}`;
        }

        function findMessageOptionAnchor(group) {
            if (!group) return null;

            const optionButton = group.querySelector('button[aria-label="메시지 옵션"]');
            if (!optionButton) return null;

            return optionButton.closest('.dropdown-button') || optionButton;
        }

        function findRerollButtonAnchor(group) {
            if (!group) return null;

            const buttons = Array.from(group.querySelectorAll('button'));
            const compareButton = findCompareButtonInGroup(group);
            const optionButton = group.querySelector('button[aria-label="메시지 옵션"]');

            return buttons.find(btn => {
                if (!btn || btn === compareButton || btn === optionButton) return false;
                if (btn.closest('.dropdown-button')) return false;

                const text = normalizeText(btn.textContent || '');
                if (/답변\s*비교\s*\d+\s*\/\s*\d+/.test(text)) return false;

                const html = btn.innerHTML || '';
                return (
                    html.includes('M3.8 12a8.2') ||
                    html.includes('M3.8 12') ||
                    html.includes('A9.8 9.8') ||
                    html.includes('A8.21 8.21') ||
                    /viewBox="0 0 24 24"[\s\S]*?M3\.8\s+12/.test(html)
                );
            }) || null;
        }

        function findSmartAnchor(group) {
            const compareButton = findCompareButtonInGroup(group);
            if (compareButton) {
                return {
                    anchor: compareButton,
                    placement: 'compare-left'
                };
            }

            const rerollButton = findRerollButtonAnchor(group);
            if (rerollButton) {
                return {
                    anchor: rerollButton,
                    placement: 'reroll-left'
                };
            }

            const optionAnchor = findMessageOptionAnchor(group);
            if (optionAnchor) {
                return {
                    anchor: optionAnchor,
                    placement: 'option-left'
                };
            }

            return {
                anchor: null,
                placement: 'fallback'
            };
        }

        function ensureBadge(group) {
            let badge = group.querySelector(`.${BADGE_CLASS}`);

            if (!badge) {
                badge = document.createElement('span');
                badge.className = `${BADGE_CLASS} relative inline-flex items-center justify-center overflow-hidden whitespace-nowrap font-medium transition-colors duration-200 h-6 rounded px-2 py-1 text-xs bg-transparent text-line-gray-2`;
                badge.setAttribute('aria-label', '메시지 생성 시각');
            }

            const { anchor, placement } = findSmartAnchor(group);

            if (anchor?.parentElement) {
                if (badge.parentElement !== anchor.parentElement || badge.nextElementSibling !== anchor) {
                    anchor.parentElement.insertBefore(badge, anchor);
                }
                badge.dataset.placement = placement;
            } else if (badge.parentElement !== group) {
                group.appendChild(badge);
                badge.dataset.placement = 'fallback';
            }

            return badge;
        }

        function setBadge(group, resolved) {
            if (!resolved?.date) return;

            const badge = ensureBadge(group);
            const label = formatBadgeDate(resolved.date);
            const full = formatFullDate(resolved.date);

            badge.textContent = label;
            badge.title = `${full}\n${resolved.note || ''}\nmessageId: ${resolved.messageId || ''}`.trim();
            badge.dataset.source = resolved.source || 'dom';

            if (resolved.source === 'api-current-reroll') {
                badge.dataset.rerollResolved = 'true';
            } else {
                delete badge.dataset.rerollResolved;
            }
        }

        function processGroup(group) {
            if (!group || !group.matches?.(MESSAGE_SELECTOR)) return;

            const key = makeCacheKey(group);
            if (!key) return;

            const cached = resultCache.get(key);

            if (cached) {
                setBadge(group, cached);
                return;
            }

            const fallback = resolveByDomId(group);
            if (fallback.date) {
                setBadge(group, fallback);
            }

            const compare = parseCompareButton(group);

            if (RESOLVE_COMPARE_BY_API && compare && compare.total > 1) {
                resolveCurrentMessageTime(group).then(resolved => {
                    resultCache.set(key, resolved);
                    setBadge(group, resolved);
                });
            } else {
                resultCache.set(key, fallback);
            }
        }

        function collectGroupsFromNode(node) {
            if (!node || node.nodeType !== Node.ELEMENT_NODE) return [];

            const el = node;
            const groups = [];

            if (el.matches?.(MESSAGE_SELECTOR)) groups.push(el);
            el.querySelectorAll?.(MESSAGE_SELECTOR).forEach(group => groups.push(group));

            return groups;
        }

        function scanAllVisibleGroups() {
            resetPageCacheIfNeeded();
            document.querySelectorAll(MESSAGE_SELECTOR).forEach(processGroup);
        }

        function scheduleScan(nodes = []) {
            clearTimeout(scanTimer);

            scanTimer = setTimeout(() => {
                resetPageCacheIfNeeded();

                if (!nodes.length) {
                    scanAllVisibleGroups();
                    return;
                }

                const groups = new Set();

                nodes.forEach(node => {
                    collectGroupsFromNode(node).forEach(group => groups.add(group));
                });

                if (!groups.size) {
                    scanAllVisibleGroups();
                    return;
                }

                groups.forEach(processGroup);
            }, 120);
        }

